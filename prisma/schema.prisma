// Quotation module data model.
// Reverse-engineered from a short screen recording of https://hyper-pos.eshopweb.store/admin/quotations
// (live network access to that host was blocked in this environment — see QUOTATION_AUDIT.md "Unknown Behavior").

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMINISTRATOR
  CASHIER
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

/// Percentage vs fixed-amount discount — the reference UI never showed a discount
/// being entered, so this shape is an assumption. See QUOTATION_AUDIT.md.
enum DiscountType {
  PERCENT
  FIXED
}

/// The reference POS's "Take payment" screen listed several options (Cash,
/// Charge via QR, Card, UPI, Bank Transfer, Cheque); kept to the two most
/// common ones here to match the "functional, not a full payment gateway"
/// scope of this rebuild.
enum PaymentMethod {
  CASH
  CARD
}

/// `name`/`code` are the existing branch label used across the UI (store
/// selectors, etc.) and were never meant to carry legal/tax details. The
/// fields below are the company's own registration/contact data as printed
/// on official documents (invoices/quotations) — added at the user's
/// request, with real values seeded directly (no Settings screen).
model Store {
  id           String       @id @default(cuid())
  name         String
  code         String       @unique
  isDefault    Boolean      @default(false)
  legalNameEn  String?
  legalNameAr  String?
  crNumber     String?
  poBox        String?
  countryEn    String?
  countryAr    String?
  addressEn    String?
  addressAr    String?
  vatNumber    String?
  mobile       String?
  email        String?
  logoUrl      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  quotations   Quotation[]
  sales        Sale[]
  users        User[]
}

model User {
  id         String      @id @default(cuid())
  name       String
  email      String      @unique
  role       UserRole    @default(CASHIER)
  storeId    String?
  store      Store?      @relation(fields: [storeId], references: [id])
  createdAt  DateTime    @default(now())
  quotations Quotation[]
  sales      Sale[]
}

model Customer {
  id              String       @id @default(cuid())
  code            String       @unique
  name            String
  email           String?
  phone           String?
  billingAddress  String?
  shippingAddress String?
  /// Standing discount applied automatically to quotations for this customer.
  /// The reference UI shows a read-only "Discount" line in the totals panel
  /// with the note "...using the selected store, customer discount, and
  /// current tax rules" but never exposes a manual discount input — so this
  /// is treated as customer-level data, not something typed on the form.
  discountType    DiscountType @default(FIXED)
  discountValue   Decimal      @default(0) @db.Decimal(12, 3)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  quotations      Quotation[]
  sales           Sale[]

  @@index([name])
  @@index([phone])
}

model Tax {
  id        String   @id @default(cuid())
  name      String
  rate      Decimal  @db.Decimal(6, 3) // percentage, e.g. 15.000 = 15%
  isDefault Boolean  @default(false)
  products  Product[]
  categories Category[]
}

/// Groups of measurement units (Count, Weight, Volume...) — mirrors the
/// reference site's "Unit Categories" page under Product Setup.
model UnitCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  units     Unit[]
}

/// A unit products are sold/measured by (pcs, kg, L...). Real, managed
/// table — replaces the old free-text Product.unit string. Conversion
/// fields mirror the reference site's data but aren't used in any
/// calculation yet (nothing in this app converts between units).
model Unit {
  id                    String        @id @default(cuid())
  shortCode             String        @unique
  displayName           String
  measurementCategoryId String
  measurementCategory   UnitCategory  @relation(fields: [measurementCategoryId], references: [id])
  baseUnitId            String?
  baseUnit              Unit?         @relation("UnitConversion", fields: [baseUnitId], references: [id])
  convertsFrom          Unit[]        @relation("UnitConversion")
  conversionFactor      Decimal?      @db.Decimal(18, 6)
  active                Boolean       @default(true)
  products              Product[]

  @@index([measurementCategoryId])
}

/// Real, managed product category table — replaces the old free-text
/// Product.category string. Supports one level of parent/child nesting,
/// matching the reference site (e.g. "Lemon-Lime" under "Soft Drinks").
model Category {
  id        String     @id @default(cuid())
  name      String
  iconColor String     @default("orange")
  taxId     String?
  tax       Tax?       @relation(fields: [taxId], references: [id])
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]

  @@index([parentId])
}

/// Manufacturer/label a product belongs to. Optional on Product — this
/// business doesn't require every product to have a brand.
model Brand {
  id          String    @id @default(cuid())
  name        String
  logoUrl     String?
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id            String          @id @default(cuid())
  sku           String          @unique
  barcode       String?         @unique
  name          String
  /// Arabic product name, shown alongside the English `name` — entered
  /// manually by the admin, never auto-translated. Added at the user's
  /// explicit approval; see QUOTATION_AUDIT.md.
  nameAr        String?
  /// English/Arabic product description — same manual-entry, no
  /// auto-translation rule as nameAr. Neither existed before; both are
  /// optional since no product had a description at all previously.
  descriptionEn String?
  descriptionAr String?
  price         Decimal         @db.Decimal(12, 3)
  /// Product photo, same as shown in the reference site's catalog/POS grid
  /// and cart. Set on the product itself (catalog data) — never uploaded
  /// from within a quotation. Null when the product has no photo yet.
  imageUrl      String?
  taxId         String?
  tax           Tax?            @relation(fields: [taxId], references: [id])
  /// Real, managed unit (replaces the old free-text string) — see the
  /// Product Setup > Units admin page.
  unitId        String
  unit          Unit            @relation(fields: [unitId], references: [id])
  /// Real, managed category (replaces the old free-text string) — see the
  /// Product Setup > Categories admin page.
  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id])
  brandId       String?
  brand         Brand?          @relation(fields: [brandId], references: [id])
  /// One-line summary shown in product pickers — distinct from the fuller
  /// descriptionEn/Ar. Added per the reference site's General tab.
  shortDescription String?
  /// When false, hidden from the cashier catalog (POS grid) — the product
  /// row itself is untouched, this only gates display.
  availableForSale Boolean       @default(true)
  /// Pins the product on the cashier's common-items rail.
  featured         Boolean       @default(false)
  /// Inventory tab settings — display/config only in this app; no stock
  /// ledger exists yet, so these don't drive any real quantity tracking.
  trackStock       Boolean       @default(true)
  soldByWeight     Boolean       @default(false)
  trackBatches     Boolean       @default(false)
  trackExpiry      Boolean       @default(false)
  expiryDate       DateTime?
  reorderAt        Int?
  reorderQuantity  Int?
  /// Cost/MRP are for margin tracking only — never used in Quotation/POS
  /// price calculations, which continue to use `price` exclusively.
  costPrice        Decimal?      @db.Decimal(12, 3)
  mrp              Decimal?      @db.Decimal(12, 3)
  priceIncludesTax Boolean       @default(false)
  /// Compliance tab — tax/regulatory fields from the reference site, kept
  /// generic (not wired into any tax calculation) since this business
  /// doesn't sell scheduled drugs.
  hsnCode          String?
  drugSchedule     String        @default("NOT_SCHEDULED")
  genericName      String?
  manufacturer     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  quotationItems QuotationItem[]
  saleItems     SaleItem[]

  @@index([name])
  @@index([categoryId])
  @@index([unitId])
}

model Quotation {
  id                    String          @id @default(cuid())
  number                String          @unique // e.g. QT-000001

  storeId               String
  store                 Store           @relation(fields: [storeId], references: [id])

  createdById           String
  createdBy             User            @relation(fields: [createdById], references: [id])

  // Either an existing Customer OR walk-in "prospect" details, never both.
  customerId            String?
  customer              Customer?       @relation(fields: [customerId], references: [id])
  prospectName           String?
  prospectEmail          String?
  prospectPhone          String?

  billingAddress        String?
  shippingAddress       String?

  issueDate             DateTime
  validUntil            DateTime?
  expectedDeliveryDate  DateTime?

  termsAndConditions    String?
  customerNotes         String?

  status                QuotationStatus @default(DRAFT)

  discountType          DiscountType    @default(FIXED)
  discountValue         Decimal         @default(0) @db.Decimal(12, 3)

  subtotal              Decimal         @default(0) @db.Decimal(12, 3)
  discountTotal         Decimal         @default(0) @db.Decimal(12, 3)
  taxTotal               Decimal         @default(0) @db.Decimal(12, 3)
  total                 Decimal         @default(0) @db.Decimal(12, 3)

  convertedSaleId       String?
  convertedAt           DateTime?

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  items                 QuotationItem[]

  @@index([status])
  @@index([customerId])
  @@index([issueDate])
}

model QuotationItem {
  id            String       @id @default(cuid())
  quotationId   String
  quotation     Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  productId     String
  product       Product      @relation(fields: [productId], references: [id])

  quantity      Decimal      @db.Decimal(12, 3)
  unitPrice     Decimal      @db.Decimal(12, 3)

  discountType  DiscountType @default(FIXED)
  discountValue Decimal      @default(0) @db.Decimal(12, 3)

  taxRate       Decimal      @default(0) @db.Decimal(6, 3)

  subtotal      Decimal      @db.Decimal(12, 3) // quantity * unitPrice - lineDiscount
  taxAmount     Decimal      @default(0) @db.Decimal(12, 3)
  lineTotal     Decimal      @db.Decimal(12, 3) // subtotal + taxAmount

  sortOrder     Int          @default(0)

  @@index([quotationId])
}

/// A completed POS sale, created directly from the /admin/pos "Cashier"
/// screen. Unlike a Quotation (which never touches stock), a Sale is a
/// real, immediate, one-shot transaction — no draft/status workflow, no
/// header-level discount (kept out to match the "functional, not a full
/// payment gateway" scope of this rebuild).
model Sale {
  id            String        @id @default(cuid())
  number        String        @unique // e.g. SE-000001

  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])

  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])

  // Optional — a walk-in sale has neither.
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])

  paymentMethod PaymentMethod

  subtotal      Decimal       @default(0) @db.Decimal(12, 3)
  taxTotal      Decimal       @default(0) @db.Decimal(12, 3)
  total         Decimal       @default(0) @db.Decimal(12, 3)

  createdAt     DateTime      @default(now())

  items         SaleItem[]

  @@index([createdAt])
  @@index([customerId])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId   String
  product     Product  @relation(fields: [productId], references: [id])

  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 3)

  taxRate     Decimal  @default(0) @db.Decimal(6, 3)
  taxAmount   Decimal  @default(0) @db.Decimal(12, 3)
  lineTotal   Decimal  @db.Decimal(12, 3) // quantity * unitPrice + taxAmount

  sortOrder   Int      @default(0)

  @@index([saleId])
}
